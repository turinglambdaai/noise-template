#!/usr/bin/env bash
#
# setup — one-shot bootstrap for a Noise + SwiftUI macOS app.
#
# Run this once (and again whenever your Racket version changes). It:
#
#   1. Detects the installed Racket version.
#   2. Checks out the matching version branch of Noise (Bogdanp/Noise) into
#      ../Noise, since the prebuilt RacketCS binaries must match your Racket
#      exactly. Falls back to nearby versions if an exact branch is missing.
#   3. Pulls the LFS binaries and builds the RacketCS xcframeworks.
#   4. Installs the Racket-side noise-serde-lib.
#   5. Compiles the app's Racket backend into app/res/core.zo and regenerates
#      the Swift client (i.e. runs `make`).
#
# After this succeeds: `swift build && .build/debug/<AppName>`.
#
# Prereqs already on your machine: Racket (CS), Xcode (swift), git, git-lfs.
set -euo pipefail

cd "$(dirname "$0")/.."

# --- config (edit these for your app) -----------------------------------
APP_NAME="App"                 # Swift executable target name
NOISE_REPO="https://github.com/Bogdanp/Noise.git"
NOISE_DIR="${NOISE_DIR:-../Noise}"
RACKET_LIB_SUBDIR="Racket"     # where noise-serde-lib lives in the checkout

log()  { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# --- 0. prereqs ---------------------------------------------------------
command -v racket >/dev/null || die "racket not found. Install Racket (CS) first."
command -v swift  >/dev/null || die "swift not found. Install Xcode first."
command -v git    >/dev/null || die "git not found."
git lfs version >/dev/null 2>&1 || die "git-lfs not found. Install it (brew install git-lfs)."
ok "prerequisites present"

# --- 1. detect racket version ------------------------------------------
RK_VER="$(racket -e '(display (version))')"
log "detected Racket ${RK_VER}"

# --- 2. match a Noise version branch -----------------------------------
# Noise branches look like racket-9.0, racket-8.18, racket-9.1-2, ...
# We prefer an exact match, then the nearest earlier version, then the
# nearest later one, so a missing exact branch still gets something usable.
#
# (Uses a sort|awk pipeline rather than bash arrays so it works on the
#  bash 3.2 that ships with macOS — no mapfile needed.)
ALL_BRANCHES="$(git ls-remote --heads "${NOISE_REPO}" \
  | sed -nE 's#.*refs/heads/(racket-.*)#\1#p' | tr -d ' ' | sort -V)"

if [[ -z "$ALL_BRANCHES" ]]; then
  die "no racket-* branch found in ${NOISE_REPO}."
fi

want_branch="racket-${RK_VER}"
if printf '%s\n' "$ALL_BRANCHES" | grep -Fxq "$want_branch"; then
  BRANCH="$want_branch"
else
  # No exact match. Merge the wanted version with the available branches,
  # sort by version, then take the line just before the wanted one (nearest
  # earlier branch). If none (wanted is older than every branch), take the
  # first branch (nearest later).
  BRANCH="$(printf '%s\n' "$ALL_BRANCHES" "$want_branch" \
            | sort -V \
            | awk -v w="$want_branch" '
                { lines[NR]=$0; if($0==w) widx=NR }
                END {
                  if (widx > 1)      print lines[widx-1]   # nearest earlier branch
                  else if (NR >= 2)  print lines[2]         # want was smallest -> first real branch
                }')"
  [[ -n "$BRANCH" ]] || BRANCH="$(printf '%s\n' "$ALL_BRANCHES" | head -1)"
fi

if [[ "$BRANCH" == "$want_branch" ]]; then
  log "using exact Noise branch ${BRANCH}"
else
  printf '\033[1;33m!\033[0m exact branch %s not found; using %s\n' "$want_branch" "$BRANCH"
fi

# --- 3. checkout Noise (version branch) + lfs + build xcframeworks ------
# Track which Racket version the xcframeworks were last built for. The branch
# name alone isn't a reliable signal (a failed prior run can leave Noise on the
# new branch with stale libs), so we record the version in a marker file and
# compare against it. Mismatched boot files vs. RacketCS static libs abort at
# boot ("petite is for Version X; need Version Y"), so on any version change
# we clean and rebuild the xcframeworks from scratch.
VERSION_MARKER="$NOISE_DIR/.built-racket-version"
NEEDS_REBUILD=1
if [[ -f "$VERSION_MARKER" ]] && [[ "$(cat "$VERSION_MARKER")" == "$RK_VER" ]]; then
  NEEDS_REBUILD=0
fi

if [[ -d "$NOISE_DIR/.git" ]]; then
  log "updating existing $NOISE_DIR (built for: $(cat "$VERSION_MARKER" 2>/dev/null || echo 'none'))"
  # Shallow-fetch doesn't create a local branch ref, so a plain `checkout
  # $BRANCH` fails when switching versions. Point the local branch at the
  # fetched commit (FETCH_HEAD) with -B, which works whether the branch
  # already exists locally or is brand new.
  git -C "$NOISE_DIR" fetch --depth 1 origin "$BRANCH"
  git -C "$NOISE_DIR" checkout -B "$BRANCH" FETCH_HEAD
else
  log "cloning Noise ${BRANCH} -> $NOISE_DIR"
  git clone --depth 1 --branch "$BRANCH" "$NOISE_REPO" "$NOISE_DIR"
fi
log "pulling LFS binaries (RacketCS static libs)"
git -C "$NOISE_DIR" lfs install
git -C "$NOISE_DIR" lfs pull

if [[ "$NEEDS_REBUILD" -eq 1 ]]; then
  log "Racket ${RK_VER} → clean-rebuilding xcframeworks"
  make -C "$NOISE_DIR" clean >/dev/null 2>&1 || true
  # Wipe SPM's incremental cache too: SwiftPM doesn't reliably detect that a
  # binaryTarget (the RacketCS xcframework) changed, so a cached link step can
  # bundle the *old* RacketCS static lib — which then mismatches the new boot
  # files and aborts at startup ("petite is for Version X; need Version Y").
  rm -rf .build
fi
# Build the iOS + macOS xcframeworks that Package.swift declares as binary
# targets. We deliberately skip the test modules target (mods.zo): its http.rkt
# needs net/http-easy, a package absent on a fresh Racket install, and the app
# doesn't use the test bundle. Building both frameworks explicitly (instead of
# `make all`) sidesteps that dependency.
log "building RacketCS xcframeworks"
make -C "$NOISE_DIR" RacketCS-ios.xcframework RacketCS-macos.xcframework
ok "Noise ready at $NOISE_DIR"
echo "$RK_VER" > "$VERSION_MARKER"

# --- 4. install noise-serde-lib (Racket side) ---------------------------
# Version branches keep it at <Noise>/Racket/noise-serde-lib. We (re)link it
# to THIS Noise checkout so it matches the version we just built. "already
# installed" is fine as long as the noise/serde module resolves afterwards —
# a broken sibling package on the machine can make the global setup step
# fail even though our package is fine, so we tolerate that and verify.
SERDE_LIB="$NOISE_DIR/$RACKET_LIB_SUBDIR/noise-serde-lib"
[[ -d "$SERDE_LIB" ]] || die "noise-serde-lib not found at $SERDE_LIB"
log "linking noise-serde-lib"
if ! raco pkg install --auto --force --link "$SERDE_LIB" >/dev/null 2>&1; then
  # Fall back to --no-setup to sidestep broken sibling packages.
  raco pkg install --no-setup --auto --force --link "$SERDE_LIB" >/dev/null 2>&1 || true
fi
# The real test: can Racket resolve noise/serde? If not, guide the user.
if ! racket -e '(require noise/serde)' >/dev/null 2>&1; then
  die "noise/serde didn't resolve. Try: raco pkg install --no-setup --force --link $SERDE_LIB"
fi
ok "noise-serde-lib resolves"

# --- 5. build the app backend ------------------------------------------
log "building app backend (make)"
make
ok "backend built"

cat <<EOF

  All set. Build & run the app:

    swift build
    .build/debug/${APP_NAME}

  When you change app-core/*.rkt, re-run \`make\` then \`swift build\`.
  When your Racket version changes, re-run this script: ./bin/setup
EOF

#!/usr/bin/env bash
#
# package — build a distributable .app and .dmg from this Noise + SwiftUI app.
#
# Does what `swift build` *doesn't*: assembles the release executable + the
# embedded core.zo into a real macOS .app bundle, then wraps it in a .dmg.
# Optionally signs and notarizes if you pass your Developer ID.
#
# Usage:
#   ./bin/package                      # unsigned App.dmg (works, but Gatekeeper
#                                      #   warns — user right-clicks → Open)
#   ./bin/package --sign "Developer ID Application: Your Name (TEAMID)"
#   ./bin/package --sign "..." --notarize "apple-id@example.com" --team-id ABCD123456
#   ./bin/package --skip-dmg           # just the .app
#
# The app name comes from APP_NAME in Package.swift (default "App"). Override
# with --name if you renamed things locally.
#
# Prereqs: a successful `./bin/setup` (Noise built, noise-serde-lib linked).
set -euo pipefail
cd "$(dirname "$0")/.."

# --- parse args ----------------------------------------------------------
APP_NAME_OVERRIDE=""
SIGN_IDENTITY=""
NOTARY_APPLE_ID=""
TEAM_ID=""
SKIP_DMG=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)      APP_NAME_OVERRIDE="$2"; shift 2 ;;
    --sign)      SIGN_IDENTITY="$2"; shift 2 ;;
    --notarize)  NOTARY_APPLE_ID="$2"; shift 2 ;;
    --team-id)   TEAM_ID="$2"; shift 2 ;;
    --skip-dmg)  SKIP_DMG=1; shift ;;
    -h|--help)
      sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

log()  { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# --- resolve names -------------------------------------------------------
# TARGET_NAME: the SPM executable target name (the actual binary file name).
#              Read from Package.swift — the binary is built as this name.
# APP_NAME:    the human-facing .app / .dmg name. Defaults to TARGET_NAME,
#              override with --name if you renamed your app locally.
TARGET_NAME="$(awk -F'"' '/let APP_NAME/{print $2}' Package.swift)"
[[ -n "$TARGET_NAME" ]] || TARGET_NAME="App"
APP_NAME="${APP_NAME_OVERRIDE:-$TARGET_NAME}"
log "target: ${TARGET_NAME}, app: ${APP_NAME}"

# --- 0. prereqs ----------------------------------------------------------
command -v swift >/dev/null || die "swift not found. Install Xcode first."
command -v make   >/dev/null || die "make not found."
[[ -f Package.swift ]] || die "Package.swift not found — run this from the project root."

# --- 1. rebuild the Racket backend (core.zo must be fresh) ---------------
log "rebuilding backend (make)"
make >/dev/null
ok "core.zo up to date"

# --- 2. release build ----------------------------------------------------
log "release build (swift build -c release)"
swift build -c release >/dev/null
ok "release binary built"

RELEASE_BIN="$(swift build -c release --show-bin-path)/${TARGET_NAME}"
[[ -x "$RELEASE_BIN" ]] || die "release binary not found at $RELEASE_BIN"

# Locate the SPM resource bundle (where .copy("res") lands).
BUNDLE_DIR="$(swift build -c release --show-bin-path)"
RES_BUNDLE="$(find "$BUNDLE_DIR" -name "${TARGET_NAME}_${TARGET_NAME}.bundle" -type d | head -1)"
[[ -d "$RES_BUNDLE" ]] || die "resource bundle not found under $BUNDLE_DIR"

# --- 3. assemble the .app ------------------------------------------------
DIST="dist"
rm -rf "$DIST"
APP_DIR="$DIST/${APP_NAME}.app"
CONTENTS="$APP_DIR/Contents"
MACOS_DIR="$CONTENTS/MacOS"
RESOURCES_DIR="$CONTENTS/Resources"

log "assembling ${APP_NAME}.app"
mkdir -p "$MACOS_DIR" "$RESOURCES_DIR"

# Executable.
cp "$RELEASE_BIN" "$MACOS_DIR/${APP_NAME}"

# core.zo (and any other res/) → Contents/Resources/res/.
# Backend+shared.swift looks for res/core.zo via Bundle.main (fallback #2),
# which resolves to Contents/Resources in a real .app bundle.
cp -R "$RES_BUNDLE/res" "$RESOURCES_DIR/res"

# Info.plist — a minimal one so the bundle is recognized as an app.
cat > "$CONTENTS/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>${APP_NAME}</string>
  <key>CFBundleDisplayName</key>
  <string>${APP_NAME}</string>
  <key>CFBundleIdentifier</key>
  <string>app.${APP_NAME}</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>${APP_NAME}</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSUIElement</key>
  <false/>
</dict>
</plist>
EOF

# Register with Launch Services so Finder shows the right icon/behavior.
touch "$APP_DIR"
ok "${APP_NAME}.app assembled at $APP_DIR"

# --- 4. optional code signing --------------------------------------------
if [[ -n "$SIGN_IDENTITY" ]]; then
  log "codesigning with '$SIGN_IDENTITY'"
  codesign --deep --force --options runtime \
           --sign "$SIGN_IDENTITY" \
           "$APP_DIR" 2>&1 | grep -v "^$" || true
  # Verify.
  if codesign --verify --deep --strict "$APP_DIR" 2>/dev/null; then
    ok "signature verified"
  else
    die "codesign verification failed"
  fi
else
  printf '\033[1;33m!\033[0m unsigned — Gatekeeper will warn until the user right-clicks → Open\n'
fi

# --- 5. optional notarization --------------------------------------------
if [[ -n "$NOTARY_APPLE_ID" ]]; then
  [[ -n "$SIGN_IDENTITY" ]] || die "--notarize requires --sign"
  [[ -n "$TEAM_ID"       ]] || die "--notarize requires --team-id"
  log "notarizing with $NOTARY_APPLE_ID (team $TEAM_ID)"
  ZIP="$DIST/${APP_NAME}.zip"
  ditto -c -k --keepParent "$APP_DIR" "$ZIP"
  xcrun notarytool submit "$ZIP" \
         --apple-id "$NOTARY_APPLE_ID" \
         --team-id "$TEAM_ID" \
         --keychain-profile "${APP_NAME}-notary" \
         --wait || die "notarization submission failed"
  xcrun stapler staple "$APP_DIR" || die "stapling failed"
  rm -f "$ZIP"
  ok "notarized + stapled"
fi

# --- 6. DMG --------------------------------------------------------------
if [[ "$SKIP_DMG" -eq 1 ]]; then
  ok "done (--skip-dmg): $APP_DIR"
  exit 0
fi

log "creating ${APP_NAME}.dmg"
DMG="$DIST/${APP_NAME}.dmg"
rm -f "$DMG"
# A read-write DMG with the .app plus a symlink to /Applications for drag-copy.
STAGING="$DIST/dmg-staging"
rm -rf "$STAGING"
mkdir -p "$STAGING"
cp -R "$APP_DIR" "$STAGING/"
ln -s /Applications "$STAGING/Applications"

hdiutil create -volname "${APP_NAME}" \
               -srcfolder "$STAGING" \
               -ov -format UDZO \
               "$DMG" >/dev/null
rm -rf "$STAGING"

# Sign the DMG too if we have an identity.
if [[ -n "$SIGN_IDENTITY" ]]; then
  codesign --sign "$SIGN_IDENTITY" "$DMG" 2>/dev/null || true
fi

ok "${APP_NAME}.dmg created ($(du -h "$DMG" | cut -f1))"
echo
printf '\033[1;32mDone.\033[0m Distribute: %s\n' "$DMG"
